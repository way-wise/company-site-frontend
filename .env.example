# --- Contact form notification email (server-only, used by /api/contact-email) ---
# NOT prefixed with NEXT_PUBLIC_ on purpose: these are secrets and must never
# reach the browser bundle.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. The visible From address; defaults to SMTP_USER. Must be an address
# the SMTP account is authorised to send as, or mail will bounce/land in spam.
SMTP_FROM=
# The two (or more) inboxes that receive each submission. Comma-separated.
CONTACT_NOTIFY_TO=first@waywisetech.com,second@waywisetech.com






